generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ActionStatus {
  INITIALIZED
  COMPLETED
  FAILED
}

model Users {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  user_name     String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  kivs          Kivs[]
}

model Sessions {
  id String @id @default(uuid())

  user_id          String @unique
  refreshTokenHash String @unique

  lastLogin DateTime
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([user_id])
}

model Kivs {
  id         String    @id @default(uuid())
  user_id    String    @unique
  user       Users     @relation(fields: [user_id], references: [id])
  trigger    Triggers?
  actions    Actions[]
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
}

model Hooks {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Actions {
  id         String   @id @default(uuid())
  kiv_id     String   @unique
  kiv        Kivs     @relation(fields: [kiv_id], references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Triggers {
  id         String   @id @default(uuid())
  kiv_id     String   @unique
  kiv        Kivs     @relation(fields: [kiv_id], references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model AvailableActions {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model KivRuns {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model KivOutboxRuns {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
